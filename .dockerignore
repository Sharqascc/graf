# Keep the Docker build context small and the image free of
# machine-local state. Everything below is regenerable or is
# excluded because it bloats the image without adding value.

# Version control and CI
.git
.github

# Python caches and build artifacts
__pycache__
*.pyc
*.pyo
*.pyd
*.egg-info
.pytest_cache
.ruff_cache
.mypy_cache
.hypothesis
build
dist

# Virtual environments
.venv
venv
env

# Local data and outputs (the demo fixture is kept; see below)
data/raw
data/interim
data/processed
data/external
outputs
*.ipynb_checkpoints

# Editors and OS
.vscode
.idea
.DS_Store
Thumbs.db

# SonarCloud scanner workspace
.scannerwork

# Node (only present if a docs build ran locally)
node_modules
